FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

RUN npm ci
RUN npm run build --workspace @enterprise-resilience/contracts
RUN npm run build --workspace @enterprise-resilience/api

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/packages/contracts/dist ./packages/contracts/dist

RUN npm ci --omit=dev --workspace @enterprise-resilience/api

EXPOSE 3000
CMD ["npm", "run", "start:prod", "--workspace", "@enterprise-resilience/api"]
